# Google Maps API Key
# Get your key from: https://console.cloud.google.com/
# 1. Create a new project or select existing
# 2. Enable Maps JavaScript API, Places API, Geocoding API, Directions API
# 3. Create API credentials -> API Key
# 4. Add this key below
VITE_GOOGLE_MAPS_API_KEY=YOUR_API_KEY_HERE

# API Base URL
# For local development: http://localhost:8080
# For production: https://your-production-api.com
VITE_API_BASE_URL=http://localhost:8080

# Instructions:
# 1. Copy this file to .env (without the .example extension)
# 2. Replace YOUR_API_KEY_HERE with your actual Google Maps API key
# 3. Never commit the .env file to version control
